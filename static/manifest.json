{
  "manifest_version": 3,
  "name": "BlockTheNoise",
  "version": "1.0.0",
  "description": "Block distracting sites, run Pomodoro focus sessions, and play music for creative flow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BlockTheNoise",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "offscreen"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "https://live.dodopayments.com/*",
    "https://test.dodopayments.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
